        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Annotation"/>
        <obo:IAO_0000115>A part-of-speech annotation is an annotation that assigns a grammatical part-of-speech category to a token.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000145</dcterms:identifier>
        <rdfs:label>Part-of-Speech Annotation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/PartOfSpeechTagging -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/PartOfSpeechTagging">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextData"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/PartOfSpeechAnnotation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A part-of-speech tagging task is a machine learning task that takes input text and assigns a part-of-speech category label to each relevant token.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000066</dcterms:identifier>
        <rdfs:label>Part-of-Speech Tagging</rdfs:label>
    </owl:Class>
    


