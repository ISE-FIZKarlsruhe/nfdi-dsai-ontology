        <dcterms:identifier>DSAI:0000015</dcterms:identifier>
        <rdfs:label>ML framework</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/MLModel -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLModel">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000203"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTrainingProcess"/>
                                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/RandomInitializationProcess"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A parameterized computational artifact that can be trained or has been trained on data, capable of performing inference on new inputs.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000016</dcterms:identifier>
        <rdfs:label>ML model</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/MLModelArchitecture -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLModelArchitecture">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000203"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLModel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A reusable computational blueprint defining the structure, connectivity, and operations of an MLModel, independent of specific parameter values.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000017</dcterms:identifier>
        <rdfs:comment>The structural configuration and computational topology of a model.</rdfs:comment>
        <rdfs:label>ML model architecture</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/MLModelType -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLModelType">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000203"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLModelArchitecture"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLModel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An information content entity that specifies the architecture and input and output types of a family of machine learning models.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000018</dcterms:identifier>
        <rdfs:label>ML model type</rdfs:label>
        <skos:editorialNote>A model type here is restricted to those latest model families which make use of at least one ML architecture</skos:editorialNote>
    </owl:Class>
    


