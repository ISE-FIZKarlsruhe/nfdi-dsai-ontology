        <obo:IAO_0000115>An instance segmentation task is a machine learning task that takes an input image and produces a separate segmentation mask and category label for each detected object instance.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000061</dcterms:identifier>
        <rdfs:label>Instance Segmentation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/InstanceSegmentationMask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/InstanceSegmentationMask">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/SegmentationMask"/>
        <obo:IAO_0000115>An instance segmentation mask is a segmentation mask that distinguishes individual object instances.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000153</dcterms:identifier>
        <rdfs:label>Instance Segmentation Mask</rdfs:label>
    </owl:Class>
    


