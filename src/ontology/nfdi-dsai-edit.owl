                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002234"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLModel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dcterms:identifier>DSAI:0000024</dcterms:identifier>
        <rdfs:label>pre-training</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/PremiseHypothesisPair -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/PremiseHypothesisPair">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextPair"/>
        <obo:IAO_0000115>A premise-hypothesis pair is a text pair consisting of a premise and a hypothesis whose inferential relation is to be determined.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000183</dcterms:identifier>
        <rdfs:label>Premise-Hypothesis Pair</rdfs:label>
    </owl:Class>
    


