                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextModality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A dialogue response is generated text intended as a conversational continuation or response.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000201</dcterms:identifier>
        <rdfs:label>Dialogue Response</rdfs:label>
    </owl:Class>
    


