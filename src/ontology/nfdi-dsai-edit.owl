        <obo:IAO_0000115>A lemma is an annotation that represents the canonical lexical form corresponding to an inflected word form.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000147</dcterms:identifier>
        <rdfs:label>Lemma</rdfs:label>
    </owl:Class>
    


