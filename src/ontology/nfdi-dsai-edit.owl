<?xml version="1.0"?>
<rdf:RDF xmlns="https://nfdi.fiz-karlsruhe.de/dsai/nfdi-dsai.owl#"
     xml:base="https://nfdi.fiz-karlsruhe.de/dsai/nfdi-dsai.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:doap="http://usefulinc.com/ns/doap#"
     xmlns:dsai="https://nfdi.fiz-karlsruhe.de/dsai/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ontology="https://nfdi.fiz-karlsruhe.de/ontology/">
    <owl:Ontology rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/nfdi-dsai.owl">
        <owl:versionIRI rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/1.0.0"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/iao/2022-11-07/iao.owl"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/stato/releases/2025-02-23/stato.owl"/>
        <owl:imports rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/3.0.4"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/identifier -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/hasInputModality -->

    <owl:ObjectProperty rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/hasInputModality">
        <rdfs:subPropertyOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
        <rdfs:domain rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <rdfs:range rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Modality"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000293"/>
            <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
        </owl:propertyChainAxiom>
        <obo:IAO_0000115 xml:lang="en">Relates a machine learning task to a modality represented by one of its specified inputs. This relation is intended to be inferred from has specified input followed by has modality.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has input modality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/hasModality -->

    <owl:ObjectProperty rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/hasModality">
        <rdfs:domain rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <rdfs:range rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Modality"/>
        <obo:IAO_0000115 xml:lang="en">Relates a machine learning data item to a modality in which that data item is represented.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has modality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/hasOutputModality -->

    <owl:ObjectProperty rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/hasOutputModality">
        <rdfs:subPropertyOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
        <rdfs:domain rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <rdfs:range rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Modality"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000299"/>
            <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
        </owl:propertyChainAxiom>
        <obo:IAO_0000115 xml:lang="en">Relates a machine learning task to a modality represented by one of its specified outputs. This relation is intended to be inferred from has specified output followed by has modality.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has output modality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality -->

    <owl:ObjectProperty rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality">
        <rdfs:domain rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <rdfs:range rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Modality"/>
        <obo:IAO_0000115 xml:lang="en">Relates a machine learning task to a modality occurring in at least one of its specified inputs or outputs.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has task modality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/hasTimestamp -->

    <owl:DatatypeProperty rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/hasTimestamp">
        <rdfs:domain rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ModelCheckpoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <dcterms:identifier>DSAI:0000001</dcterms:identifier>
        <rdfs:label>has timestamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/hasTrainingStep -->

    <owl:DatatypeProperty rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/hasTrainingStep">
        <rdfs:domain rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ModelCheckpoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dcterms:identifier>DSAI:0000002</dcterms:identifier>
        <rdfs:label>has training step</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/isBestCheckpoint -->

    <owl:DatatypeProperty rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/isBestCheckpoint">
        <rdfs:domain rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ModelCheckpoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <dcterms:identifier>DSAI:0000003</dcterms:identifier>
        <rdfs:label>is best checkpoint</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/STATO_0000416 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/STATO_0000416">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLEvaluationMetric"/>
        <skos:editorialNote>we do not need the classes, ratio, proportion, statistic</skos:editorialNote>
    </rdf:Description>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AUC-ROC -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AUC-ROC">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLEvaluationMetric"/>
        <obo:IAO_0000115>Measure of a model&apos;s ability to distinguish between classes across all thresholds.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000004</dcterms:identifier>
        <rdfs:label>area under roc curve (ROC-AUC)</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AcceptabilityCategoryLabel -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AcceptabilityCategoryLabel">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/CategoryLabel"/>
        <obo:IAO_0000115>An acceptability category label is a category label that denotes a category of linguistic acceptability.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000120</dcterms:identifier>
        <rdfs:label>Acceptability Category Label</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AcceptabilityClassification -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AcceptabilityClassification">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextData"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/AcceptabilityCategoryLabel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>An acceptability classification task is a machine learning task that takes an input text and assigns a label indicating whether the text satisfies a specified criterion of linguistic acceptability.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000034</dcterms:identifier>
        <rdfs:label>Acceptability Classification</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/Accuracy -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/Accuracy">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLEvaluationMetric"/>
        <obo:IAO_0000115>Proportion of correctly predicted instances among all instances.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000005</dcterms:identifier>
        <rdfs:label>accuracy</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/ActionPlan -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/ActionPlan">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>An action plan is a machine learning data item that specifies an ordered action or sequence of actions intended to achieve a goal from a represented state.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000175</dcterms:identifier>
        <rdfs:label>Action Plan</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/ActionPlanningTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/ActionPlanningTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ActionPlan"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>An action or planning task is a machine learning task that takes a representation of a current state and a goal or objective as input and produces an action or sequence of actions intended to achieve the goal.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000100</dcterms:identifier>
        <rdfs:label>Action / Planning Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/Annotation -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/Annotation">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>An annotation is a machine learning data item that associates a portion or element of input data with descriptive, linguistic, semantic, or structural information.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000143</dcterms:identifier>
        <rdfs:label>Annotation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AnnotationTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AnnotationTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Annotation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>An information extraction or annotation task is a machine learning task that takes input information and produces structured annotations identifying specified linguistic or semantic features in the input.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000064</dcterms:identifier>
        <rdfs:label>Annotation Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/Answer -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/Answer">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>An answer is a machine learning data item that provides information produced in response to a question.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000156</dcterms:identifier>
        <rdfs:label>Answer</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AnyToAnyTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AnyToAnyTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MultimodalInputTask"/>
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MultimodalOutputTask"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115 xml:lang="en">A machine learning task whose specified inputs collectively involve two or more modalities and whose specified outputs collectively involve two or more modalities.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Any-to-Any Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AudioClassification -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AudioClassification">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/AudioModality"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/CategoryLabel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115 xml:lang="en">A machine learning task that is a classification task and has a specified input represented in audio modality.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Audio Classification</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AudioData -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AudioData">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/AudioModality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Audio data is a machine learning data item whose information is represented as an audio signal.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000114</dcterms:identifier>
        <rdfs:label>Audio Data</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AudioGeneration -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AudioGeneration">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/GeneratedContent"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/AudioModality"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115 xml:lang="en">A machine learning task that is a generation task and has a specified output represented in audio modality.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Audio Generation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AudioModality -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AudioModality">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/DataModality"/>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Modality"/>
        <obo:IAO_0000115 xml:lang="en">A modality in which information is represented as an audio signal.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000106</dcterms:identifier>
        <rdfs:label xml:lang="en">Audio Modality</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AudioModalityTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AudioModalityTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/AudioModality"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115 xml:lang="en">A machine learning task that involves audio modality in at least one specified input or output.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Audio-modality Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/AudioToAudioTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/AudioToAudioTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/AudioModality"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/AudioModality"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115 xml:lang="en">A machine learning task that has a specified input represented in audio modality and a specified output represented in audio modality.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Audio-to-Audio Task</rdfs:label>
    </owl:Class>
    


