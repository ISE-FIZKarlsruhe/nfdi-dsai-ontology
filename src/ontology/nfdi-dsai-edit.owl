        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>An intent classification task is a machine learning task that takes an input utterance or text and assigns a label representing the intent expressed by the input.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000035</dcterms:identifier>
        <rdfs:label>Intent Classification</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/KeypointDetection -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/KeypointDetection">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ImageData"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/VideoData"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/KeypointSet"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A keypoint detection task is a machine learning task that takes an input image or video frame and produces coordinates for specified landmark points.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000056</dcterms:identifier>
        <rdfs:label>Keypoint Detection</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/KeypointSet -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/KeypointSet">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/DetectionResult"/>
        <obo:IAO_0000115>A keypoint set is a detection result that specifies coordinates of landmarks detected in visual data.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000141</dcterms:identifier>
        <rdfs:label>Keypoint Set</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/KeywordOccurrence -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/KeywordOccurrence">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TimeIntervalAnnotation"/>
        <obo:IAO_0000115>A keyword occurrence is a time interval annotation identifying the occurrence of a specified spoken keyword.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000196</dcterms:identifier>
        <rdfs:label>Keyword Occurrence</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/KeywordSpotting -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/KeywordSpotting">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/SpeechData"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/KeywordOccurrence"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A keyword spotting task is a machine learning task that takes an input audio signal and produces labels or time locations indicating occurrences of specified spoken keywords.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000059</dcterms:identifier>
        <rdfs:label>Keyword Spotting</rdfs:label>
    </owl:Class>
    


