        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A pose estimation task is a machine learning task that takes an input image or video frame and produces keypoint coordinates or other parameters representing the pose of a detected subject.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000057</dcterms:identifier>
        <rdfs:label>Pose Estimation</rdfs:label>
    </owl:Class>
    


