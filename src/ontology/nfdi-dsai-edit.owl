        <obo:IAO_0000115>A document retrieval query is a retrieval query used to select relevant documents.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000215</dcterms:identifier>
        <rdfs:label>Document Retrieval Query</rdfs:label>
    </owl:Class>
    


