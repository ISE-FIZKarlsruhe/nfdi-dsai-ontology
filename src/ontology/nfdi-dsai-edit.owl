            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A segmentation mask is a machine learning data item that assigns regions or elements of visual data to semantic categories or object instances.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000152</dcterms:identifier>
        <rdfs:label>Segmentation Mask</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/SegmentationTask -->

