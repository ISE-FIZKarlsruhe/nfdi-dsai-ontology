                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A natural language inference task is a machine learning task that takes a premise text and a hypothesis text as input and assigns a label indicating the inferential relation between them.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000040</dcterms:identifier>
        <rdfs:label>Natural Language Inference</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/NaturalLanguageProcessingTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/NaturalLanguageProcessingTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextModality"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115 xml:lang="en">A machine learning task that involves information represented in text modality as a specified input or output. This operational definition supports inference of text-based and cross-modal language tasks.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Natural Language Processing Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/NumericValue -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/NumericValue">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>A numeric value is a machine learning data item that represents a quantity using a number.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000131</dcterms:identifier>
        <rdfs:label>Numeric Value</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/ObjectDetection -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/ObjectDetection">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ImageData"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/VideoData"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/BoundingBox"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>An object detection task is a machine learning task that takes an input image or video frame and produces locations and category labels for detected objects.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000053</dcterms:identifier>
        <rdfs:label>Object Detection</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/PanopticSegmentation -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/PanopticSegmentation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ImageData"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/PanopticSegmentationMask"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A panoptic segmentation task is a machine learning task that takes an input image and produces a segmentation in which image elements receive semantic labels and countable object instances receive distinct instance identifiers.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000063</dcterms:identifier>
        <rdfs:label>Panoptic Segmentation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/PanopticSegmentationMask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/PanopticSegmentationMask">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/SegmentationMask"/>
        <obo:IAO_0000115>A panoptic segmentation mask is a segmentation mask that combines semantic category assignments with distinct identifiers for countable object instances.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000155</dcterms:identifier>
        <rdfs:label>Panoptic Segmentation Mask</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/ParseRepresentation -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/ParseRepresentation">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Annotation"/>
        <obo:IAO_0000115>A parse representation is an annotation that represents syntactic or grammatical structure and relations in linguistic data.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000146</dcterms:identifier>
        <rdfs:label>Parse Representation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/Parsing -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/Parsing">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextData"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ParseRepresentation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A parsing task is a machine learning task that takes input text and produces a structured representation of syntactic or grammatical relations among its elements.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000067</dcterms:identifier>
        <rdfs:label>Parsing</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/PartOfSpeechAnnotation -->

