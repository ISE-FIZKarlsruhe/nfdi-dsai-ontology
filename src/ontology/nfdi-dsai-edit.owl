        <obo:IAO_0000115>A sentiment category label is a category label that denotes a categorical sentiment such as positive, negative, or neutral.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000123</dcterms:identifier>
        <rdfs:label>Sentiment Category Label</rdfs:label>
    </owl:Class>
    


