        <obo:IAO_0000115>A regression or estimation task is a machine learning task that takes input data and produces one or more continuous or ordered numeric estimates.</obo:IAO_0000115>
        <obo:IAO_0000115>A regression task is a machine learning task that takes input data and predicts one or more continuous numeric values.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000045</dcterms:identifier>
        <dcterms:identifier>DSAI:0000046</dcterms:identifier>
        <rdfs:label xml:lang="en">Regression</rdfs:label>
        <rdfs:label>Regression</rdfs:label>
    </owl:Class>
    


