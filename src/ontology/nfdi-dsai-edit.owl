        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Annotation"/>
        <obo:IAO_0000115>A slot value annotation is an annotation that associates a predefined information slot with a value or span extracted from input data.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000151</dcterms:identifier>
        <rdfs:label>Slot Value Annotation</rdfs:label>
    </owl:Class>
    


