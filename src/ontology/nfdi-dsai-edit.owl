                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A similarity assessment task is a machine learning task that takes two or more input items and produces a score or label representing their similarity according to a specified criterion.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000097</dcterms:identifier>
        <rdfs:label>Similarity Assessment Task</rdfs:label>
    </owl:Class>
    


