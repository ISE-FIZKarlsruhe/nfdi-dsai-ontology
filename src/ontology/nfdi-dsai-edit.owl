        <dcterms:identifier>DSAI:0000033</dcterms:identifier>
        <rdfs:label>Classification Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/Colorization -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/Colorization">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ColorizedContent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A colorization task is a machine learning task that takes grayscale or incompletely colored visual data as input and produces a colorized version of the visual data.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000088</dcterms:identifier>
        <rdfs:label>Colorization</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/ColorizedContent -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/ColorizedContent">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/RestoredContent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ImageModality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Colorized content is restored visual information in which color information has been added or reconstructed.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000211</dcterms:identifier>
        <rdfs:label>Colorized Content</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/CompletedContent -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/CompletedContent">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>Completed content is a machine learning data item that fills, predicts, or continues a missing or incomplete portion of input content.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000162</dcterms:identifier>
        <rdfs:label>Completed Content</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/CompletionTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/CompletionTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/CompletedContent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A completion task is a machine learning task that takes partially specified content as input and produces content that fills or continues the missing portion.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000084</dcterms:identifier>
        <rdfs:label>Completion Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/ComputerVisionTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/ComputerVisionTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ImageModality"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ThreeDimensionalModality"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                                <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/VideoModality"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115 xml:lang="en">A machine learning task that involves image, video, or three-dimensional modality as a specified input or output. This operational definition supports inference of visual and cross-modal vision tasks.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Computer Vision Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/CoreferenceAnnotation -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/CoreferenceAnnotation">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Annotation"/>
        <obo:IAO_0000115>A coreference annotation is an annotation that links or groups expressions that refer to the same entity.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000149</dcterms:identifier>
        <rdfs:label>Coreference Annotation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/CoreferenceResolution -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/CoreferenceResolution">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextData"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/CoreferenceAnnotation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A coreference resolution task is a machine learning task that takes input text and produces links or clusters identifying expressions that refer to the same entity.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000070</dcterms:identifier>
        <rdfs:label>Coreference Resolution</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/DataModality -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/DataModality">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115>A data modality is an information content entity that specifies a mode or form in which data used or produced by a machine learning task is represented.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000103</dcterms:identifier>
        <rdfs:label>Data Modality</rdfs:label>
    </owl:Class>
    


