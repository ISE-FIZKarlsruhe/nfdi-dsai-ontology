        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A simplification task is a machine learning task that takes input text and produces text expressing substantially the same content in a simpler form.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000083</dcterms:identifier>
        <rdfs:label>Simplification Task</rdfs:label>
    </owl:Class>
    


