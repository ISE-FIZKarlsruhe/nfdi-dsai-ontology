        <obo:IAO_0000115>A similarity assessment is a machine learning data item that represents the assessed similarity between two or more information items as a score or category.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000171</dcterms:identifier>
        <rdfs:label>Similarity Assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/SimilarityAssessmentTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/SimilarityAssessmentTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/SimilarityInputSet"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
