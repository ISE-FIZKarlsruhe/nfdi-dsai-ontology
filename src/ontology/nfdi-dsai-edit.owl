            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A summary is text data that concisely represents the main information contained in a longer input.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000158</dcterms:identifier>
