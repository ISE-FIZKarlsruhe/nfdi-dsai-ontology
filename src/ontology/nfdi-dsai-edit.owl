    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/SimilarityInputSet">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>A similarity input set is a machine learning data item containing two or more items whose similarity is to be assessed.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000221</dcterms:identifier>
        <rdfs:label>Similarity Input Set</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/SimplificationTask -->

