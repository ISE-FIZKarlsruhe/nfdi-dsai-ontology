            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Simplified text is text data that expresses substantially the same content as source text in a simpler form.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000161</dcterms:identifier>
        <rdfs:label>Simplified Text</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/SlotFilling -->

