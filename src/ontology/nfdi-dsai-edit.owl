    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/QuestionContext">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>A question context is a machine learning data item containing a question and any supporting context supplied for answering it.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000199</dcterms:identifier>
        <rdfs:label>Question Context</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/RMSE -->

