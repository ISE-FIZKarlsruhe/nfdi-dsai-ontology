                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextData"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/SlotValueAnnotation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A slot filling task is a machine learning task that takes an input utterance or text and produces values or labeled spans for predefined information slots.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000072</dcterms:identifier>
        <rdfs:label>Slot Filling</rdfs:label>
    </owl:Class>
    


