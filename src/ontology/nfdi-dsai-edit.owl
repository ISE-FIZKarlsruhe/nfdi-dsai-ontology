                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ThreeDimensionalModality"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TimeSeriesModality"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/ThreeDimensionalModality"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/VideoModality"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TimeSeriesModality"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasTaskModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/VideoModality"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115 xml:lang="en">A machine learning task that involves at least two distinct modalities across its specified inputs and outputs.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Multimodal Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/NamedEntityAnnotation -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/NamedEntityAnnotation">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Annotation"/>
        <obo:IAO_0000115>A named entity annotation is an annotation that identifies a span or token as an instance of a named-entity category.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000144</dcterms:identifier>
        <rdfs:label>Named Entity Annotation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/NamedEntityRecognition -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/NamedEntityRecognition">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextData"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/NamedEntityAnnotation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A named entity recognition task is a machine learning task that takes input text and produces spans or tokens annotated with named-entity category labels.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000065</dcterms:identifier>
        <rdfs:label>Named Entity Recognition</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/NaturalLanguageInference -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/NaturalLanguageInference">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/PremiseHypothesisPair"/>
