        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A depth estimation task is a machine learning task that takes an input image or video frame and produces estimated depth values for locations in the visual input.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000051</dcterms:identifier>
        <rdfs:label>Depth Estimation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/DepthValue -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/DepthValue">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/EstimatedValue"/>
        <obo:IAO_0000115>A depth value is an estimated value that represents the distance or depth associated with a location in visual data.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000137</dcterms:identifier>
        <rdfs:label>Depth Value</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/DetectionResult -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/DetectionResult">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>A detection result is a machine learning data item that identifies the presence and, where applicable, the location or time interval of a detected target.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000139</dcterms:identifier>
        <rdfs:label>Detection Result</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/DetectionTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/DetectionTask">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/DetectionResult"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A detection task is a machine learning task that takes input data and produces the locations, time intervals, or presence indicators of specified target entities or events.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000052</dcterms:identifier>
        <rdfs:label>Detection Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/DialogueGeneration -->

