        <obo:IAO_0000115>A ranked list is a machine learning data item that represents candidate items in an order determined by a specified ranking criterion.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000170</dcterms:identifier>
        <rdfs:label>Ranked List</rdfs:label>
    </owl:Class>
    


