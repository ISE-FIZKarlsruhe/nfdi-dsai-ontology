                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/AudioModality"/>
                                    </owl:Restriction>
