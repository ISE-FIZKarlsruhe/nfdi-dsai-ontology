            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A translation is text data that expresses in a target language information corresponding to information expressed in a source language.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000159</dcterms:identifier>
        <rdfs:label>Translation</rdfs:label>
    </owl:Class>
    


