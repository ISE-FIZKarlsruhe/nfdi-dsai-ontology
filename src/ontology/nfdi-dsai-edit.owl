            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A transcription is text data that represents linguistic content conveyed in speech or other audio.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000160</dcterms:identifier>
        <rdfs:label>Transcription</rdfs:label>
    </owl:Class>
    


