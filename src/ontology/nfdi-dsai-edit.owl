        <obo:IAO_0000115>A semantic similarity classification task is a machine learning task that takes two input texts and assigns a categorical label indicating their degree or class of semantic similarity.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000039</dcterms:identifier>
        <rdfs:label>Semantic Similarity Classification</rdfs:label>
    </owl:Class>
    


