            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A caption generation task is a machine learning task that takes visual or other media content as input and produces a natural-language caption describing that content.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000077</dcterms:identifier>
        <rdfs:label>Caption Generation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/CategoryLabel -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/CategoryLabel">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>A category label is a machine learning data item that denotes membership in, or assignment to, a category used as an output of a classification task.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000119</dcterms:identifier>
        <rdfs:label>Category Label</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/Checkpoint -->

