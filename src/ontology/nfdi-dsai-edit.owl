    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/PlanningInput">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>A planning input is information representing an initial or current state, available actions, and a goal.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000223</dcterms:identifier>
        <rdfs:label>Planning Input</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/PoseEstimation -->

