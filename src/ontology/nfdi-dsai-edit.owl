        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>A ranking input is information containing a query or context together with candidate items to be ordered.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000220</dcterms:identifier>
        <rdfs:label>Ranking Input</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/RankingTask -->

