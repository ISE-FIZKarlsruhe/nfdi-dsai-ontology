    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/LanguageCategoryLabel">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/CategoryLabel"/>
        <obo:IAO_0000115>A language category label is a category label that denotes a natural language.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000122</dcterms:identifier>
        <rdfs:label>Language Category Label</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/LanguageIdentification -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/LanguageIdentification">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
