        <obo:IAO_0000115>A semantic segmentation task is a machine learning task that takes an input image and assigns a semantic category label to each pixel or image element.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000062</dcterms:identifier>
        <rdfs:label>Semantic Segmentation</rdfs:label>
    </owl:Class>
    


