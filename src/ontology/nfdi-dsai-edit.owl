        <obo:IAO_0000115 xml:lang="en">A modality in which information is represented in a tabular arrangement of rows and columns.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000108</dcterms:identifier>
        <rdfs:label xml:lang="en">Tabular Modality</rdfs:label>
    </owl:Class>
    


