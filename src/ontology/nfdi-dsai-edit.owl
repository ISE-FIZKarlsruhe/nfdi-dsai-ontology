        <obo:IAO_0000115>Source-language text is text data expressed in a language from which a translation is to be produced.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000207</dcterms:identifier>
        <rdfs:label>Source-Language Text</rdfs:label>
    </owl:Class>
    


