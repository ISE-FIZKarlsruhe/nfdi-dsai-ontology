        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A language identification task is a machine learning task that takes input text or speech and assigns a label identifying the language of the input.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000036</dcterms:identifier>
        <rdfs:label>Language Identification</rdfs:label>
    </owl:Class>
    


