        <obo:IAO_0000115>A task planning task is a machine learning task that takes a representation of an initial state, available actions, and a goal as input and produces an ordered plan of actions intended to reach the goal.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000102</dcterms:identifier>
        <rdfs:label>Task Planning</rdfs:label>
    </owl:Class>
    


