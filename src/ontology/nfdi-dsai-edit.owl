        <dcterms:identifier>DSAI:0000030</dcterms:identifier>
        <rdfs:label>checkpoint</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/ClassificationTask -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/ClassificationTask">
