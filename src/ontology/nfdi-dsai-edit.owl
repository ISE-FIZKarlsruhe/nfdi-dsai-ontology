                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/hasModality"/>
                                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextModality"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115 xml:lang="en">A machine learning task that has a specified input represented in audio modality and a specified output represented in text modality.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">Audio-to-Text Task</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/BoundingBox -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/BoundingBox">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/DetectionResult"/>
        <obo:IAO_0000115>A bounding box is a detection result that specifies a bounded spatial region containing a detected object in visual data.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000140</dcterms:identifier>
        <rdfs:label>Bounding Box</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/CaptionGeneration -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/CaptionGeneration">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/GeneratedCaption"/>
                    </owl:Restriction>
