                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/TextData"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/Lemma"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A lemmatization task is a machine learning task that takes inflected word forms in input text and produces their corresponding canonical lemma forms.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000068</dcterms:identifier>
        <rdfs:label>Lemmatization</rdfs:label>
    </owl:Class>
    


