        <obo:IAO_0000115>A machine learning data item is an information content entity that is specified as input to, output of, or otherwise processed by a machine learning task.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000111</dcterms:identifier>
        <rdfs:label>Machine Learning Data Item</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/MaskGeneration -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MaskGeneration">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/GeneratedMask"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A mask generation task is a machine learning task that takes visual input and produces one or more masks identifying specified regions of that input.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000079</dcterms:identifier>
        <rdfs:label>Mask Generation</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/MaskedContent -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MaskedContent">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MachineLearningDataItem"/>
        <obo:IAO_0000115>Masked content is information containing one or more explicitly masked portions whose content is to be predicted.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000209</dcterms:identifier>
        <rdfs:label>Masked Content</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/MaskedContentCompletion -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MaskedContentCompletion">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MaskedContent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/CompletedContent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
        <obo:IAO_0000115>A masked-content completion task is a machine learning task that takes input containing one or more masked portions and predicts content for the masked portions.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000085</dcterms:identifier>
        <rdfs:label>Masked-Content Completion</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/Modality -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/Modality">
