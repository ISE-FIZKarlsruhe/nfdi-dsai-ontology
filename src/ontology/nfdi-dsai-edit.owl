        <obo:IAO_0000115>An emotion category label is a category label that denotes an emotion category expressed or represented in input data.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000130</dcterms:identifier>
        <rdfs:label>Emotion Category Label</rdfs:label>
    </owl:Class>
    


