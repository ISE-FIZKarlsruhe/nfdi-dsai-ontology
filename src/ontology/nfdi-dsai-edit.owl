    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <obo:IAO_0000115>A machine learning task is a process of turning data into decisions or predictions.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000019</dcterms:identifier>
        <rdfs:label>Machine Learning Task</rdfs:label>
    </owl:Class>
    


