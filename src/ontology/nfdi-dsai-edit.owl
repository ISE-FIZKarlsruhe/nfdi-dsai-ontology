    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/PoseRepresentation">
        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/KeypointSet"/>
        <obo:IAO_0000115>A pose representation is a keypoint set or related structured representation specifying the pose of a subject.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000194</dcterms:identifier>
        <rdfs:label>Pose Representation</rdfs:label>
    </owl:Class>
    


