        <rdfs:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/dsai/CategoryLabel"/>
        <obo:IAO_0000115>An intent category label is a category label that denotes a communicative or behavioral intent.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000121</dcterms:identifier>
        <rdfs:label>Intent Category Label</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/IntentClassification -->

    <owl:Class rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/IntentClassification">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/dsai/MLTask"/>
                    <owl:Restriction>
