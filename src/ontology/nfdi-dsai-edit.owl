        <obo:IAO_0000115>An entity link is an annotation that associates a mention in input data with an identifier for a corresponding entity in a reference knowledge source.</obo:IAO_0000115>
        <dcterms:identifier>DSAI:0000150</dcterms:identifier>
        <rdfs:label>Entity Link</rdfs:label>
    </owl:Class>
    


    <!-- https://nfdi.fiz-karlsruhe.de/dsai/EntityLinking -->

